<Page
    x:Class="PowerX.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls"
    xmlns:local="using:PowerX.App.Views">

    <Page.Resources>
        <Style x:Key="ColHeader" TargetType="Button" BasedOn="{StaticResource TextBlockButtonStyle}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Processes" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Filter" Grid.Column="0" PlaceholderText="Filter processes…" TextChanged="Filter_TextChanged" />
            <Button Grid.Column="1" Content="Reset columns" FontSize="12" Click="ResetColumns_Click" />
            <ToggleButton x:Name="FreezeButton" Grid.Column="2" MinWidth="96" Click="Freeze_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE916;" FontSize="12" />
                    <TextBlock Text="Freeze" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- header row; trailing margin leaves room for the list's scrollbar.
             Column boundaries are draggable — see the pointer handlers wired in code-behind. -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
            <Grid>
                <ctl:ResizeGrid x:Name="HeaderGrid" Margin="8,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="74" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource ColHeader}" Tag="name" Click="Header_Click" x:Name="HName" Content="Name" />
                    <Button Grid.Column="1" Style="{StaticResource ColHeader}" Tag="pid"  Click="Header_Click" x:Name="HPid"  Content="PID" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="2" Style="{StaticResource ColHeader}" Tag="cpu"  Click="Header_Click" x:Name="HCpu"  Content="CPU" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="3" Style="{StaticResource ColHeader}" Tag="mem"  Click="Header_Click" x:Name="HMem"  Content="Memory" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="4" Style="{StaticResource ColHeader}" Tag="io"   Click="Header_Click" x:Name="HIo"   Content="Disk I/O" HorizontalContentAlignment="Right" />
                    <Button Grid.Column="5" Style="{StaticResource ColHeader}" Tag="thr"  Click="Header_Click" x:Name="HThr"  Content="Threads" HorizontalContentAlignment="Right" />
                </ctl:ResizeGrid>

                <!-- thin guide shown while hovering / dragging a boundary -->
                <Rectangle x:Name="ResizeGuide" Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <ListView Grid.Row="3" x:Name="List" SelectionMode="Single"
                  ShowsScrollingPlaceholders="False"
                  ContainerContentChanging="List_ContainerContentChanging"
                  IsDoubleTapEnabled="True" DoubleTapped="List_DoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProcessRow">
                    <Grid Height="30" Padding="0,0,8,0">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="Menu_Opening" Closed="Menu_Closed">
                                <MenuFlyoutItem Text="End task" Icon="Cancel" Click="End_Click" />
                                <MenuFlyoutItem Text="End process tree" Click="EndTree_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Suspend" Click="Suspend_Click" />
                                <MenuFlyoutItem Text="Resume" Click="Resume_Click" />
                                <MenuFlyoutItem Text="Efficiency mode" Click="Eco_Click" />
                                <MenuFlyoutSubItem Text="Priority">
                                    <MenuFlyoutItem Text="Realtime" Tag="Realtime" Click="Priority_Click" />
                                    <MenuFlyoutItem Text="High" Tag="High" Click="Priority_Click" />
                                    <MenuFlyoutItem Text="Above normal" Tag="AboveNormal" Click="Priority_Click" />
                                    <MenuFlyoutItem Text="Normal" Tag="Normal" Click="Priority_Click" />
                                    <MenuFlyoutItem Text="Below normal" Tag="BelowNormal" Click="Priority_Click" />
                                    <MenuFlyoutItem Text="Low" Tag="Idle" Click="Priority_Click" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Open file location" Click="OpenLocation_Click" />
                                <MenuFlyoutItem Text="Copy executable path" Click="CopyPath_Click" />
                                <MenuFlyoutItem Text="Copy PID" Click="CopyPid_Click" />
                                <MenuFlyoutItem Text="Search the web" Click="Search_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Details…" Click="Props_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>

                        <!-- left accent bar: blue → amber → red for the CPU hogs -->
                        <Rectangle Grid.ColumnSpan="6" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                   Margin="0,2,0,2" RadiusX="1.5" RadiusY="1.5" IsHitTestVisible="False"
                                   Fill="{x:Bind CpuBar, Mode=OneWay}" />

                        <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Pid}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Grid.Column="2" Background="{x:Bind CpuHeat, Mode=OneWay}" CornerRadius="4" Margin="1,2">
                            <TextBlock Text="{x:Bind CpuText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,7,0" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                       FontWeight="{x:Bind CpuWeight, Mode=OneWay}" />
                        </Border>
                        <Border Grid.Column="3" Background="{x:Bind MemHeat, Mode=OneWay}" CornerRadius="4" Margin="1,2">
                            <TextBlock Text="{x:Bind WorkingSet, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,7,0" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                       FontWeight="{x:Bind MemWeight, Mode=OneWay}" />
                        </Border>
                        <TextBlock Grid.Column="4" Text="{x:Bind Io, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,6,0" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind Threads, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,6,0" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
