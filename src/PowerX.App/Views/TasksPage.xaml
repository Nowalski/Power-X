<Page NavigationCacheMode="Enabled"
    x:Class="PowerX.App.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The scroller spans both columns and its PageScrollStyle padding keeps its cards out of
             the narrow one, so the rows above end at the same right edge as the cards below. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <TextBlock Text="Scheduled tasks" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Summary" Style="{StaticResource MutedStyle}" Text="Loading..." />
        </StackPanel>

        <InfoBar Grid.Row="1" IsOpen="True" Severity="Informational" IsClosable="False"
                 Message="Disabling a task is fully reversible and never deletes it. PowerX takes a position only on well-known tasks; everything else is shown read-labelled so you can decide. Windows components are left alone." />

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Filter" Grid.Column="0" PlaceholderText="Search tasks..." TextChanged="Filter_Changed" />
            <ToggleButton x:Name="ReviewedOnly" Grid.Column="1" Content="Reviewed only" Click="Filter_Toggled" />
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export CSV..." Click="Export_Click" />
            <Button x:Name="RefreshButton" Grid.Column="3" Content="Rescan" Click="Refresh_Click" />
        </Grid>

        <ScrollViewer Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource PageScrollStyle}">
            <StackPanel x:Name="List" Spacing="6" Padding="0,0,0,16" />
        </ScrollViewer>
    </Grid>
</Page>
