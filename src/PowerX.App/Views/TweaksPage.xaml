<Page
    x:Class="PowerX.App.Views.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="14" Padding="0,0,0,28">

            <StackPanel Spacing="2">
                <TextBlock Text="Tweaks" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource MutedStyle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <StackPanel Spacing="1">
                    <TextBlock Text="Profiles" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="One click applies a named set. You see exactly what changes and confirm first, and every item stays individually reversible."
                               Style="{StaticResource MutedStyle}" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>
                <ctl:WrapPanel x:Name="ProfileStrip" HorizontalSpacing="12" VerticalSpacing="12"
                               ItemWidth="264" ItemHeight="204" />
            </StackPanel>

            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                     Message="Every change is reversible and recorded in Change history. Nothing is applied until you toggle it or apply a profile." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Filter" Grid.Column="0" PlaceholderText="Search tweaks…" TextChanged="Filter_Changed" />
                <ToggleButton x:Name="RecOnly" Grid.Column="1" Content="Recommended only" Click="RecOnly_Click" />
            </Grid>

            <StackPanel x:Name="Sections" Spacing="6" />

        </StackPanel>
    </ScrollViewer>
</Page>
