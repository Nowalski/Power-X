<Page
    x:Class="PowerX.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls"
    xmlns:local="using:PowerX.App.Views">

    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TileGrid.(Grid.ColumnDefinitions)[1].Width" Value="0" />
                            <Setter Target="GpuCard.(Grid.Row)" Value="1" />
                            <Setter Target="GpuCard.(Grid.Column)" Value="0" />
                            <Setter Target="BottomGrid.(Grid.ColumnDefinitions)[1].Width" Value="0" />
                            <Setter Target="RecCard.(Grid.Row)" Value="1" />
                            <Setter Target="RecCard.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="TileGrid.(Grid.ColumnDefinitions)[1].Width" Value="*" />
                            <Setter Target="GpuCard.(Grid.Row)" Value="0" />
                            <Setter Target="GpuCard.(Grid.Column)" Value="1" />
                            <Setter Target="BottomGrid.(Grid.ColumnDefinitions)[1].Width" Value="*" />
                            <Setter Target="RecCard.(Grid.Row)" Value="0" />
                            <Setter Target="RecCard.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel Spacing="2">
                <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubHeadline" Style="{StaticResource MutedStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Quick actions" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel x:Name="QuickActions" Orientation="Horizontal" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="CPU" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ctl:RingGauge x:Name="CpuGauge" Caption="load" VerticalAlignment="Center" />
                        <ctl:AreaChart x:Name="CpuSpark" Grid.Column="1" Height="132" MinWidth="180" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="CpuDetail" Style="{StaticResource MutedStyle}" />
                </StackPanel>
            </Border>

            <Grid x:Name="TileGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="120">
                            <TextBlock Text="Memory" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="MemValue" Style="{StaticResource MonoStyle}" FontSize="16" Text="—" />
                            <TextBlock x:Name="MemDetail" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                        <ctl:AreaChart x:Name="MemSpark" Grid.Column="1" Height="64" MinWidth="120" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="GpuCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="120">
                            <TextBlock Text="GPU" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="GpuValue" Style="{StaticResource MonoStyle}" FontSize="16" Text="—" />
                            <TextBlock x:Name="GpuDetail" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                        <ctl:AreaChart x:Name="GpuSpark" Grid.Column="1" Height="64" MinWidth="120" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="BottomGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Top processes by CPU" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="TopProcesses">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NameValueVm">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource MonoStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="RecCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recommendations" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="Recommendations">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Padding="0,4" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton x:Name="OpenTweaks" Content="Review in Tweaks →" Padding="0,4,0,0" Click="OpenTweaks_Click" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
