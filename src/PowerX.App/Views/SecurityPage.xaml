<Page
    x:Class="PowerX.App.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">

            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Security" Style="{StaticResource PageTitleStyle}" />
                    <ctl:InfoButton Title="What this is"
                                    Body="PowerX is not an antivirus. Microsoft Defender, or the antivirus you have installed, is your protection. This page shows Defender's own status, the threats it has already caught, and lets you start a Defender scan. The hash check asks an open, public database whether a file is a known, catalogued file. It sends only the file's SHA-256, over HTTPS, and only when you click." />
                </StackPanel>
                <TextBlock x:Name="Summary" Style="{StaticResource MutedStyle}" Text="Reading Defender status…" />
            </StackPanel>

            <InfoBar x:Name="UnprotectedBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="No active antivirus"
                     Message="This machine has no real-time antivirus running. Turn Microsoft Defender or another antivirus back on." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Microsoft Defender" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="ModeText" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                    <ctl:WrapPanel x:Name="Chips" HorizontalSpacing="8" VerticalSpacing="8" />
                    <TextBlock x:Name="DefsText" Style="{StaticResource MutedStyle}" FontSize="12" />
                    <TextBlock x:Name="ScansText" Style="{StaticResource MutedStyle}" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Scan" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="QuickScanButton" Content="Quick scan" Click="QuickScan_Click" />
                        <Button x:Name="FullScanButton" Content="Full scan" Click="FullScan_Click" />
                        <Button x:Name="StopScanButton" Content="Stop" IsEnabled="False" Click="StopScan_Click" />
                    </StackPanel>
                    <TextBox x:Name="ScanOut" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="180" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                             Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Threats Defender has caught" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel x:Name="ThreatList" Spacing="6" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Check a file" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Style="{StaticResource MutedStyle}" FontSize="12" TextWrapping="Wrap"
                               Text="Look a file's SHA-256 up in the CIRCL hash database (hashlookup.circl.lu), a free, open catalogue of known files. Only the hash is sent." />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Grid.Column="0" PlaceholderText="Path to a file, or a SHA-256 hash" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="Browse_Click" />
                        <Button x:Name="CheckButton" Grid.Column="2" Content="Check" Style="{StaticResource AccentButtonStyle}" Click="Check_Click" />
                    </Grid>
                    <TextBlock x:Name="HashText" Style="{StaticResource MonoStyle}" FontSize="12" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                    <InfoBar x:Name="HashResultBar" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
