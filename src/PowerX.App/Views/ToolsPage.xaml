<Page
    x:Class="PowerX.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">
            <TextBlock Text="Tools" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Name="RebootBar" IsOpen="False" IsClosable="False" Severity="Warning"
                     Title="A restart is pending">
                <StackPanel Spacing="4" Margin="0,4,0,4">
                    <TextBlock x:Name="RebootReasons" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Restart now" Click="RestartNow_Click" />
                        <Button Content="Re-check" Click="RebootRecheck_Click" />
                    </StackPanel>
                </StackPanel>
            </InfoBar>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Power plan" Style="{StaticResource SectionHeaderStyle}" />
                        <ctl:InfoButton Title="Power plans"
                                        Body="A power plan controls how hard Windows works to lower CPU frequency and park cores when idle. Balanced is right for almost everyone. High and Ultimate performance keep clocks high and cut some idle latency. That is worth a few percent in latency-sensitive work, costs battery on a laptop, and does nothing measurable for FPS in most games. Power saver caps performance to stretch battery life." />
                    </StackPanel>
                    <TextBlock x:Name="PowerCurrent" Style="{StaticResource MutedStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Balanced" Click="Balanced_Click" />
                        <Button Content="High performance" Click="HighPerf_Click" />
                        <Button Content="Ultimate performance" Click="Ultimate_Click" />
                        <Button Content="Power saver" Click="Saver_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                               Text="High and Ultimate keep the CPU at higher clocks and cut some power-saving latency. Marginal on desktops, worse battery on laptops, and not a magic FPS switch." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Windows Update" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="WuStatus" Style="{StaticResource MutedStyle}" Text="Checking…" />
                        </StackPanel>
                        <InfoBadge x:Name="WuBadge" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Pause 7 days" Tag="7" Click="WuPause_Click" />
                        <Button Content="Pause 35 days (max)" Tag="35" Click="WuPause_Click" />
                        <Button x:Name="WuDisableButton" Content="Disable completely" Click="WuDisable_Click" />
                        <Button Content="Restore defaults" Style="{StaticResource AccentButtonStyle}" Click="WuRestore_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                               Text="Disable completely stops the update services, tasks and policy, so the machine stops getting security patches. It is a security trade-off. Use Restore to undo it. Windows caps Pause at 35 days." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Disk cleanup" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="CleanupTotal" Style="{StaticResource MutedStyle}" Text="Scanning…" />
                        </StackPanel>
                        <Button x:Name="CleanButton" Grid.Column="1" Content="Clean selected"
                                Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="Clean_Click"
                                VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <ctl:SegmentBar x:Name="CleanupBar" />
                        <ProgressBar x:Name="CleanProgress" Minimum="0" Maximum="100" Visibility="Collapsed" ShowPaused="False" />
                        <TextBlock x:Name="CleanProgressText" Style="{StaticResource MutedStyle}" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="CleanupList" Spacing="2" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Component store (WinSxS)" Style="{StaticResource SectionHeaderStyle}" />
                        <ctl:InfoButton Title="The component store"
                                        Body="WinSxS holds every version of every Windows component, so updates can be uninstalled and system files repaired. It looks huge in Explorer because most of it is hard links shared with the live system, not a second copy. The part that is safe to reclaim is superseded components and backups. PowerX runs the Microsoft-recommended cleanup only, never /ResetBase (which would permanently block uninstalling installed updates)." />
                    </StackPanel>
                    <TextBlock x:Name="WinSxsText" Style="{StaticResource MutedStyle}" Text="Not analyzed yet." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="WinSxsAnalyzeButton" Content="Analyze" Click="WinSxsAnalyze_Click" />
                        <Button x:Name="WinSxsCleanButton" Content="Run component cleanup" Click="WinSxsClean_Click" IsEnabled="False" />
                        <Button x:Name="WinSxsStopButton" Content="Stop" Click="WinSxsStop_Click" IsEnabled="False" />
                    </StackPanel>
                    <TextBox x:Name="WinSxsOut" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas, Cascadia Mono, monospace"
                             MaxHeight="160" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Border x:Name="BatteryCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Battery health" Style="{StaticResource SectionHeaderStyle}" />
                        <ctl:InfoButton Title="Battery wear"
                                        Body="Every rechargeable battery loses capacity with age and charge cycles. Wear is how much of the original (design) capacity is gone: under 15 percent is normal for a healthy battery, 30 percent or more means noticeably shorter runtime. The numbers come from powercfg's battery report. Nothing here changes any setting." />
                    </StackPanel>
                    <TextBlock x:Name="BatteryHeadline" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="BatteryDetail" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Full battery report" Click="BatteryReport_Click" />
                        <Button Content="Refresh" Click="BatteryRefresh_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Disks" Style="{StaticResource SectionHeaderStyle}" />
                        <Button Grid.Column="1" Content="Open Disk Management" Click="DiskMgmt_Click" />
                    </Grid>
                    <StackPanel x:Name="DiskList" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Environment variables" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock x:Name="EnvSummary" Style="{StaticResource MutedStyle}" />
                        </StackPanel>
                        <Button x:Name="EnvAdd" Grid.Column="1" Content="Add" Click="EnvAdd_Click" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox x:Name="EnvFilter" PlaceholderText="Filter…" TextChanged="EnvFilter_Changed" />
                    <ItemsControl x:Name="EnvList" MaxHeight="320" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="System protection" Style="{StaticResource SectionHeaderStyle}" />
                        <ctl:InfoButton Title="Restore points"
                                        Body="A restore point is a snapshot of system files, drivers, the registry and installed programs. It does not include your documents. If a change breaks Windows you can roll back to one. Make one before a batch of tweaks or a driver update. Windows does the rollback itself, and it needs a restart." />
                    </StackPanel>
                    <TextBlock x:Name="RestoreStatus" Style="{StaticResource MutedStyle}" Text="Checking…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CreateRpButton" Content="Create restore point" Click="CreateRp_Click" />
                        <Button Content="View restore points" Click="ListRp_Click" />
                        <Button Content="Open System Restore" Click="OpenRp_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="System shortcuts" Style="{StaticResource SectionHeaderStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Files &amp; folders" Style="{StaticResource MutedStyle}" />
                        <ctl:WrapPanel x:Name="ShortcutRow1" HorizontalSpacing="8" VerticalSpacing="8" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Diagnostics" Style="{StaticResource MutedStyle}" />
                        <ctl:WrapPanel x:Name="ShortcutRow2" HorizontalSpacing="8" VerticalSpacing="8" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Management consoles" Style="{StaticResource MutedStyle}" />
                        <ctl:WrapPanel x:Name="ShortcutRow3" HorizontalSpacing="8" VerticalSpacing="8" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Settings pages" Style="{StaticResource MutedStyle}" />
                        <ctl:WrapPanel x:Name="ShortcutRow4" HorizontalSpacing="8" VerticalSpacing="8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Learn" Style="{StaticResource SectionHeaderStyle}" />
                        <ctl:InfoButton Title="About these notes"
                                        Body="Short, vendor-neutral explanations of the settings PowerX can change, so you can decide for yourself. No affiliate links, no scare tactics." />
                    </StackPanel>
                    <StackPanel x:Name="LearnList" Spacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
