<Page
    x:Class="PowerX.App.Views.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls"
    xmlns:local="using:PowerX.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="GPU" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="AdapterName" Style="{StaticResource SectionHeaderStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox x:Name="AdapterPicker" Grid.Column="1" VerticalAlignment="Bottom"
                          Visibility="Collapsed" MinWidth="200"
                          SelectionChanged="AdapterPicker_SelectionChanged" />
            </Grid>

            <Border x:Name="UnavailableCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <TextBlock x:Name="UnavailableText" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <ctl:RingGauge x:Name="Gauge" Caption="load" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverallSub" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ctl:AreaChart x:Name="Spark" Grid.Column="1" Height="118" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid x:Name="DetailGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SecondCol" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SecondCol.Width" Value="0" />
                                <Setter Target="VramCard.(Grid.Row)" Value="1" />
                                <Setter Target="VramCard.(Grid.Column)" Value="0" />
                                <Setter Target="SpecCard.(Grid.Row)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1100" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SecondCol.Width" Value="*" />
                                <Setter Target="VramCard.(Grid.Row)" Value="0" />
                                <Setter Target="VramCard.(Grid.Column)" Value="1" />
                                <Setter Target="SpecCard.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Engines" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="Engines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CoreVm">
                                    <Grid ColumnSpacing="12" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="96" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ctl:LoadBar Grid.Column="1" Value="{x:Bind Usage, Mode=OneWay}" Animated="False" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Text, Mode=OneWay}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Style="{StaticResource MonoStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="VramCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Video memory" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="12" HorizontalAlignment="Left" MaxWidth="460">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="84" />
                                <ColumnDefinition Width="*" MinWidth="60" />
                                <ColumnDefinition Width="Auto" MinWidth="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dedicated" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="VramBar" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock x:Name="VramText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource MonoStyle}" />
                        </Grid>
                        <TextBlock x:Name="SharedText" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="SpecCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Adapter" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="Spec">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NameValueVm">
                                    <Grid Padding="0,3" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Top"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12"
                                                   VerticalAlignment="Top" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource MutedStyle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Temperature, power and clock speeds are not exposed by any built-in Windows API and are intentionally not shown." />
                    </StackPanel>
                </Border>

            </Grid>

            <StackPanel x:Name="AdaptersSection" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Per GPU" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel x:Name="AdapterCards" Spacing="10" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
