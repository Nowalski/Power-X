<Page
    x:Class="PowerX.App.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Style="{StaticResource PageHeaderStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Repair &amp; diagnostics" Style="{StaticResource PageTitleStyle}" />
                <ctl:InfoButton Title="How to repair Windows"
                                Body="Corruption usually clears up by running DISM /RestoreHealth (rebuilds the component store from Windows Update) then SFC /scannow (repairs protected system files from the now-healthy store). The Run recommended repair button does both in order. Everything here is a standard Microsoft tool, and the output is shown live." />
            </StackPanel>
            <TextBlock Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                       Text="Standard Windows repair tools. Output streams live in the console. One job runs at a time." />
        </StackPanel>

        <!-- The one thing most people come here for, as its own card: what it does, how long it
             takes, and a single button. Stop and Clear live on the console, next to what they act on. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Recommended repair" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource MutedStyle}" TextWrapping="Wrap"
                               Text="Repairs the Windows image with DISM RestoreHealth, then the system files with SFC. Needs internet and usually takes 15 to 40 minutes." />
                </StackPanel>
                <Button x:Name="RecommendedButton" Grid.Column="2" Content="Run recommended repair" VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="Recommended_Click" />
            </Grid>
        </Border>

        <!-- No column spacing: the job list's PageScrollStyle already keeps 16 px clear on its
             right for the scrollbar, and spacing on top of that left a 32 px gap.
             The job list keeps its share in a narrow window but stops growing at a width where a
             card reads comfortably; the console takes the rest, up to the page cap (ListCap, set
             in code). As two plain shares the console grew to an empty box over 1700 px wide on
             an ultrawide monitor. -->
        <Grid Grid.Row="2" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MaxWidth="560" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- One card per category (Integrity, Disk, Network...), its jobs as rows split by the
                 row divider, like Settings. Built in code from CommandRunner.Jobs. -->
            <ScrollViewer Grid.Column="0" Style="{StaticResource PageScrollStyle}">
                <StackPanel x:Name="JobList" Spacing="16" Padding="0,0,0,12" />
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Header like every other card's: title, then the same divider under it. -->
                    <Grid Padding="18,12,12,12" ColumnSpacing="10" BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE756;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ConsoleTitle" Text="Console" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ConsoleStatus" Style="{StaticResource MutedStyle}" Text="Idle"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ProgressRing x:Name="RunSpinner" Grid.Column="2" Width="18" Height="18" IsActive="False" VerticalAlignment="Center" />
                        <Button x:Name="StopButton" Grid.Column="3" Content="Stop" IsEnabled="False" Click="Stop_Click" VerticalAlignment="Center" />
                        <Button Grid.Column="4" Content="Clear" Click="Clear_Click" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             BorderThickness="0" Background="Transparent" Padding="18,14"
                             FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    <!-- The hint sits over the empty console rather than being its text: console
                         output must not wrap (it would break up tables), but a hint that does not
                         wrap was cut off mid-word in a narrow window. Shown only while the console
                         is empty. -->
                    <TextBlock x:Name="ConsoleHint" Grid.Row="1" Margin="18,14" TextWrapping="Wrap" IsHitTestVisible="False"
                               FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Pick a job and press Run. Its output appears here, line by line." />
                </Grid>
            </Border>
        </Grid>

        <!-- Memory test: an always-open card whose size never changes. It was an Expander under
             the job list and console, so opening it took their height in one jump, and starting a
             test jumped again as the progress bar and result appeared. Now the controls sit on
             one row and the second row has a fixed height for the status text and the progress
             bar, which only changes its Opacity. Nothing in the card is ever Collapsed, and the
             Start/Stop button has a MinWidth so its label change cannot resize it either.
             The slider's column takes the room first (100* against the spacer's 1*) up to its
             MaxWidth; past that the spacer takes the rest, keeping Start at the right edge. -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,0,0,16">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100*" MinWidth="100" MaxWidth="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Memory test" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <ctl:InfoButton Title="About this test"
                                        Body="Grabs a large block of free RAM and runs pattern write/verify and moving-inversion passes over it. It catches an unstable overclock or a failing module, but it only tests free memory and runs alongside Windows. For a full test use Windows Memory Diagnostic (needs a reboot) or MemTest86." />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="Size" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="MemSize" Grid.Column="3" Minimum="1" Maximum="8" Value="4" StepFrequency="1" VerticalAlignment="Center" />
                    <TextBlock x:Name="MemSizeText" Grid.Column="4" Text="4 GB" VerticalAlignment="Center"
                               Style="{StaticResource MonoStyle}" MinWidth="44" />
                    <ComboBox x:Name="MemPasses" Grid.Column="5" SelectedIndex="1" VerticalAlignment="Center" MinWidth="112">
                        <ComboBoxItem Content="1 pass" />
                        <ComboBoxItem Content="2 passes" />
                        <ComboBoxItem Content="4 passes" />
                        <ComboBoxItem Content="8 passes" />
                    </ComboBox>
                    <Button x:Name="MemStart" Grid.Column="6" Content="Start" Click="MemStart_Click" VerticalAlignment="Center" MinWidth="72" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MemResult" Style="{StaticResource MutedStyle}" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="Checks free RAM for errors while Windows runs. Not run yet." />
                    <ProgressBar x:Name="MemProgress" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" Opacity="0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
