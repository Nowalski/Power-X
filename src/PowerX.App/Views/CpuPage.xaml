<Page
    x:Class="PowerX.App.Views.CpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls"
    xmlns:local="using:PowerX.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">

            <StackPanel Spacing="2">
                <TextBlock Text="CPU" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="CpuName" Style="{StaticResource SectionHeaderStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <ctl:RingGauge x:Name="Gauge" Caption="load" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverallSub" Style="{StaticResource MutedStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <ctl:AreaChart x:Name="Spark" Height="118" VerticalAlignment="Center" />
                        <TextBlock x:Name="Detail" Style="{StaticResource MutedStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="DetailGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SecondCol" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SecondCol.Width" Value="0" />
                                <Setter Target="CoresCard.(Grid.Row)" Value="1" />
                                <Setter Target="CoresCard.(Grid.Column)" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1100" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SecondCol.Width" Value="*" />
                                <Setter Target="CoresCard.(Grid.Row)" Value="0" />
                                <Setter Target="CoresCard.(Grid.Column)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Specification" Style="{StaticResource SectionHeaderStyle}" />
                            <ctl:InfoButton Title="Reading these"
                                            Body="Base speed is the guaranteed all-core clock; max speed is the best-case single-core boost. SMT (Hyper-Threading) lets one physical core run two threads. Virtualization must be on in firmware for Hyper-V, WSL2, Sandbox and Android emulators. SLAT / nested paging is required for those to run efficiently." />
                        </StackPanel>
                        <ItemsControl x:Name="Spec">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:NameValueVm">
                                    <Grid Padding="0,4" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="96" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Top"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Top" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="CoresCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Logical processors" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl x:Name="Cores">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:CoreVm">
                                    <Grid ColumnSpacing="10" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="46" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ctl:LoadBar Grid.Column="1" Value="{x:Bind Usage, Mode=OneWay}" Animated="False" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Text, Mode=OneWay}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Style="{StaticResource MonoStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
