<Page
    x:Class="PowerX.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:PowerX.App.Controls"
    xmlns:local="using:PowerX.App.Views">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel x:Name="Root" Spacing="16" Padding="0,0,0,24">

            <TextBlock Text="Network" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="118" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Download" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DownValue" Style="{StaticResource MonoStyle}" FontSize="19" />
                        </StackPanel>
                        <ctl:AreaChart x:Name="DownSpark" Grid.Column="1" Height="64" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="118" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="Upload" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UpValue" Style="{StaticResource MonoStyle}" FontSize="19" />
                        </StackPanel>
                        <ctl:AreaChart x:Name="UpSpark" Grid.Column="1" Height="64" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DiagHost" Grid.Column="0" PlaceholderText="host or IP (e.g. 1.1.1.1)" Text="1.1.1.1" />
                        <Button x:Name="PingButton" Grid.Column="1" Content="Ping" Click="Ping_Click" />
                        <Button x:Name="TraceButton" Grid.Column="2" Content="Trace" Click="Trace_Click" />
                        <Button x:Name="DnsButton" Grid.Column="3" Content="DNS" Click="Dns_Click" />
                        <Button x:Name="DiagStop" Grid.Column="4" Content="Stop" IsEnabled="False" Click="DiagStop_Click" />
                    </Grid>
                    <TextBox x:Name="DiagOut" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="148"
                             FontFamily="Consolas, Cascadia Mono, monospace" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="Interfaces" Spacing="10" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Listening ports" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="ListenSummary" Style="{StaticResource MutedStyle}" Text="Scanning…" />
                    <Grid Padding="8,4" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*" MinWidth="60" />
                            <ColumnDefinition Width="0.6*" MinWidth="52" />
                            <ColumnDefinition Width="1.6*" MinWidth="100" />
                            <ColumnDefinition Width="1.6*" MinWidth="100" />
                            <ColumnDefinition Width="0.9*" MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Proto" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Process" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Bound to" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Reach" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <ItemsControl x:Name="ListenList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ListenVm">
                                    <Grid Padding="8,3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.7*" MinWidth="60" />
                                            <ColumnDefinition Width="0.6*" MinWidth="52" />
                                            <ColumnDefinition Width="1.6*" MinWidth="100" />
                                            <ColumnDefinition Width="1.6*" MinWidth="100" />
                                            <ColumnDefinition Width="0.9*" MinWidth="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Port}" Style="{StaticResource MonoStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Proto}" Style="{StaticResource MonoStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Process}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Bound}" Style="{StaticResource MonoStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Reach}" FontSize="11" Foreground="{x:Bind ReachBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border x:Name="ProcNetCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Per-process network use" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="ProcNetSummary" Style="{StaticResource MutedStyle}" Text="Measuring…" />
                    <Grid Padding="8,4" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="110" />
                            <ColumnDefinition Width="1*" MinWidth="80" />
                            <ColumnDefinition Width="1*" MinWidth="80" />
                            <ColumnDefinition Width="1.2*" MinWidth="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Down" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Up" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Total this session" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ItemsControl x:Name="ProcNetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ProcNetVm">
                                <Grid Padding="8,3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="110" />
                                        <ColumnDefinition Width="1*" MinWidth="80" />
                                        <ColumnDefinition Width="1*" MinWidth="80" />
                                        <ColumnDefinition Width="1.2*" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Down}" Style="{StaticResource MonoStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Up}" Style="{StaticResource MonoStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Total}" Style="{StaticResource MonoStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Active connections" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                        <TextBox x:Name="ConnFilter" Grid.Column="1" MinWidth="170" PlaceholderText="Filter"
                                 TextChanged="ConnFilter_Changed" />
                        <ToggleButton x:Name="ResolveToggle" Grid.Column="2" Content="Resolve names" Checked="Resolve_Toggled" Unchecked="Resolve_Toggled" />
                        <Button x:Name="CopyConnButton" Grid.Column="3" Content="Copy" Click="CopyConn_Click" />
                    </Grid>
                    <TextBlock x:Name="ConnSummary" Style="{StaticResource MutedStyle}" Text="Scanning…" />
                    <Grid Padding="8,4" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" MinWidth="90" />
                            <ColumnDefinition Width="0.5*" MinWidth="44" />
                            <ColumnDefinition Width="2*" MinWidth="110" />
                            <ColumnDefinition Width="2*" MinWidth="110" />
                            <ColumnDefinition Width="1*" MinWidth="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Process" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Proto" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="Local" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Remote" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="State" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <ItemsControl x:Name="Connections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ConnVm">
                                    <Grid Padding="8,3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.6*" MinWidth="90" />
                                            <ColumnDefinition Width="0.5*" MinWidth="44" />
                                            <ColumnDefinition Width="2*" MinWidth="110" />
                                            <ColumnDefinition Width="2*" MinWidth="110" />
                                            <ColumnDefinition Width="1*" MinWidth="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Proto}" Style="{StaticResource MonoStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Local}" Style="{StaticResource MonoStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Remote}" Style="{StaticResource MonoStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind State}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
