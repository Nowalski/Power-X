<Page NavigationCacheMode="Enabled"
    x:Class="PowerX.App.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="What changed" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Summary" Style="{StaticResource MutedStyle}" Text="Loading snapshots…" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FromBox" Grid.Column="0" HorizontalAlignment="Stretch" Header="Compare from"
                      SelectionChanged="Selection_Changed" />
            <FontIcon Grid.Column="1" Glyph="&#xE72A;" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="14" />
            <ComboBox x:Name="ToBox" Grid.Column="2" HorizontalAlignment="Stretch" Header="to"
                      SelectionChanged="Selection_Changed" />
            <Button x:Name="SnapButton" Grid.Column="3" Content="Take snapshot now" VerticalAlignment="Bottom"
                    Click="Snap_Click" />
        </Grid>

        <InfoBar Grid.Row="2" IsOpen="True" Severity="Informational" IsClosable="False"
                 Message="PowerX takes a configuration snapshot in the background about once a day. It compares startup entries, scheduled tasks, auto-start services, installed programs, signed drivers and applied tweaks. Everything stays on this PC." />

        <ScrollViewer Grid.Row="3" Style="{StaticResource PageScrollStyle}">
            <StackPanel x:Name="List" Spacing="8" Padding="0,0,0,16" />
        </ScrollViewer>
    </Grid>
</Page>
