<Page NavigationCacheMode="Enabled"
    x:Class="PowerX.App.Views.EventLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Event log" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="Summary" Style="{StaticResource MutedStyle}" Text="Reading the event logs..." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Filter" Grid.Column="0" PlaceholderText="Search source, message..." TextChanged="Filter_Changed" />
            <ComboBox x:Name="WindowBox" Grid.Column="1" SelectedIndex="1" SelectionChanged="Reload">
                <ComboBoxItem Content="Last 24 hours" />
                <ComboBoxItem Content="Last 7 days" />
                <ComboBoxItem Content="Last 30 days" />
            </ComboBox>
            <ToggleButton x:Name="WarnToggle" Grid.Column="2" Content="Warnings" Click="Reload" />
            <Button x:Name="ExportButton" Grid.Column="3" Content="Export CSV..." Click="Export_Click" />
            <Button x:Name="RefreshButton" Grid.Column="4" Content="Refresh" Click="Reload" />
        </Grid>

        <ScrollViewer Grid.Row="2" Style="{StaticResource PageScrollStyle}">
            <StackPanel x:Name="List" Spacing="6" Padding="0,0,0,16" />
        </ScrollViewer>
    </Grid>
</Page>
