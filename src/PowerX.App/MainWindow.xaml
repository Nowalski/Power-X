<Window
    x:Class="PowerX.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="Palette_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Height="44" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="9">
                <Image Source="ms-appx:///Assets/logo-64.png" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="PowerX" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsPaneToggleButtonVisible="True"
                             PaneDisplayMode="Left"
                             OpenPaneLength="220"
                             IsSettingsVisible="True"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="2,4,0,4">
                    <Image Source="ms-appx:///Assets/logo-128.png" Width="24" Height="24" VerticalAlignment="Center" />
                    <TextBlock Text="PowerX" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="PaletteEntry" PlaceholderText="Search   Ctrl+K" QueryIcon="Find"
                                GotFocus="PaletteEntry_GotFocus" />
            </muxc:NavigationView.AutoSuggestBox>
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="home" IsSelected="True">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Health check" Tag="health">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Monitor" />
                <muxc:NavigationViewItem Content="Processes" Tag="processes">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="CPU" Tag="cpu">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Memory" Tag="memory">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEEA0;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="GPU" Tag="gpu">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xF211;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Network" Tag="network">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Firewall" Tag="firewall">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Software" />
                <muxc:NavigationViewItem Content="Programs" Tag="programs">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Debloat" Tag="debloat">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Startup" Tag="startup">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B5;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Scheduled tasks" Tag="tasks">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Services" Tag="services">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xF0E3;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Drivers" Tag="drivers">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Optimize &amp; fix" />
                <muxc:NavigationViewItem Content="Tweaks" Tag="tweaks">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Tools" Tag="tools">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEC7A;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Storage explorer" Tag="storage">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Repair" Tag="repair">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Crash insights" Tag="crashes">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Event log" Tag="events">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Security" Tag="security">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="What changed" Tag="changes">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7BC;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Change history" Tag="history">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel Padding="12,4,12,10" Spacing="1">
                    <TextBlock x:Name="FooterVersion" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="FooterElevation" FontSize="11" Opacity="0.6" />
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar x:Name="UpdateBar" Grid.Row="0" Margin="28,12,28,0" IsOpen="False" Severity="Success"
                         Title="Update available" CloseButtonClick="UpdateBar_Close">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4" VerticalAlignment="Center">
                        <Button x:Name="UpdateInstallButton" Content="Download &amp; install"
                                Style="{StaticResource AccentButtonStyle}" Click="UpdateInstall_Click" Visibility="Collapsed" />
                        <ProgressBar x:Name="UpdateProgress" Width="120" VerticalAlignment="Center"
                                     Minimum="0" Maximum="1" Visibility="Collapsed" />
                        <Button x:Name="UpdateReleasesButton" Content="Open releases" Click="UpdateBar_Open" />
                    </StackPanel>
                </InfoBar>
                <Frame x:Name="ContentFrame" Grid.Row="1" Padding="28,20,28,0">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <EntranceNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Grid>
        </muxc:NavigationView>

        <!-- command palette overlay -->
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#66000000" Tapped="PaletteOverlay_Tapped">
            <Border Width="560" MaxHeight="440" VerticalAlignment="Top" Margin="0,90,0,0"
                    HorizontalAlignment="Center" CornerRadius="10" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Tapped="PaletteCard_Tapped">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox" Grid.Row="0" Margin="10" PlaceholderText="Type a command or page…"
                             TextChanged="PaletteBox_TextChanged" KeyDown="PaletteBox_KeyDown" />
                    <ListView x:Name="PaletteList" Grid.Row="1" Margin="4,0,4,8" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="PaletteList_ItemClick" MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
