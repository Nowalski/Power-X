<Application
    x:Class="PowerX.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Dividers. Same 1 px stroke as the line above the version in the navigation pane
                 footer (NavigationView draws that one with DividerStrokeColorDefaultBrush), so every
                 separator in the app reads as the same material. -->

            <!-- A page's title block (title, subtitle, info button): the rule under it separates the
                 page's name from its content on every page, at the same distance. -->
            <Style x:Key="PageHeaderStyle" TargetType="StackPanel">
                <Setter Property="Spacing" Value="2" />
                <Setter Property="Padding" Value="0,0,0,14" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <!-- The same, for a title block laid out as a Grid (a title with a picker beside it). -->
            <Style x:Key="PageHeaderGridStyle" TargetType="Grid">
                <Setter Property="Padding" Value="0,0,0,14" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <!-- Under a card's header row. The negative side margins equal CardStyle's padding, so the
                 line runs edge to edge across the card like the pane footer's does across the pane.
                 Only for cards with the default 18 px padding. -->
            <Style x:Key="CardDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="-18,0,-18,0" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- Between rows or groups inside a card (Settings rows, shortcut groups). Inset to the
                 content, not edge to edge, so it groups without cutting the card in two. -->
            <Style x:Key="RowDividerStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextBlockStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
            </Style>

            <Style x:Key="MonoStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Right padding keeps content clear of the scrollbar gutter so the page never
                 shifts left/right when the scrollbar appears as data loads in.
                 HorizontalContentAlignment=Stretch forces the ScrollContentPresenter to give the
                 content the viewport width — without it the content is measured unconstrained and
                 keeps whatever width it had when the window was smaller (things get clipped as you
                 enlarge the window). -->
            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0,0,16,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
