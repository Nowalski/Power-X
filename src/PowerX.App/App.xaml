<Application
    x:Class="PowerX.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextBlockStyle}">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace" />
                <Setter Property="IsTextSelectionEnabled" Value="False" />
            </Style>

            <Style x:Key="MonoStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Right padding keeps content clear of the scrollbar gutter so the page never
                 shifts left/right when the scrollbar appears as data loads in.
                 HorizontalContentAlignment=Stretch forces the ScrollContentPresenter to give the
                 content the viewport width — without it the content is measured unconstrained and
                 keeps whatever width it had when the window was smaller (things get clipped as you
                 enlarge the window). -->
            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollMode" Value="Disabled" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0,0,16,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
