# Normalize line endings: repo stores LF, Windows checkout gets CRLF for source.
* text=auto

*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.xaml      text eol=crlf
*.manifest  text eol=crlf
*.sln       text eol=crlf -whitespace
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.md        text

*.png binary
*.jpg binary
*.ico binary
